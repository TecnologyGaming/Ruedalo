{
  "expo": {
    "name": "RideVE",
    "slug": "rideve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rideve",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rideve.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBzsybeLDdXmxiF4jYbt3zYa5N8x1xtKKQ"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mostrar tu ubicación y conductores cercanos",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Compartir tu ubicación durante el viaje"
      }
    },
    "android": {
      "package": "com.rideve.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0C10"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBzsybeLDdXmxiF4jYbt3zYa5N8x1xtKKQ"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a RideVE acceder a tu ubicación."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C10"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
