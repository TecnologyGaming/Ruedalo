rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /verifications/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role in ['admin', 'support']);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
